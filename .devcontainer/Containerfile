# Dev Container image for cicd-squabbler
# Base: Chainguard Wolfi (minimal, supply-chain-secure)
# Build: podman build -t cicd-squabbler-dev -f .devcontainer/Containerfile .
# `:latest` suits a dev container (rebuilt daily); pin by digest
# (...@sha256:<digest>) if you need a reproducible dev environment.

FROM cgr.dev/chainguard/wolfi-base:latest

# Install common development tools
RUN apk update && apk add --no-cache \
    bash \
    curl \
    git \
    openssh-client \
    ca-certificates \
    build-base \
    posix-libc-utils \
    shadow \
    && rm -rf /var/cache/apk/*

# Create non-root dev user (matches devcontainer.json remoteUser)
RUN groupadd -g 1000 nonroot || true \
    && useradd -m -u 1000 -g 1000 -s /bin/bash nonroot || true

# ---------------------------------------------------------------------------
# Rust: the toolchain this repository is written in.
#
# The image previously shipped no Rust at all, so `cargo build` was impossible
# in the dev container. Both toolchains are installed here:
#   * stable          — builds/tests the workspace (root `rust-version = 1.85`);
#   * Creusot's nightly — used only below `verification/`, pinned by
#     verification/squabble-creusot/rust-toolchain.toml.
#
# Creusot's *prover* stack (opam + Why3 + an SMT solver) is deliberately NOT
# baked in: it is a several-hundred-megabyte OCaml build that most sessions do
# not need, and this image is rebuilt daily. Run `just verify-install` on first
# boot to add it; until then the Creusot obligations are STATED, NOT PROVED
# (docs/CREUSOT.adoc).
# ---------------------------------------------------------------------------
USER nonroot
# No RUSTUP_TOOLCHAIN override: cargo must honour
# verification/squabble-creusot/rust-toolchain.toml (Creusot's nightly) inside
# that directory while defaulting to stable everywhere else.
ENV HOME=/home/nonroot \
    CARGO_HOME=/home/nonroot/.cargo \
    RUSTUP_HOME=/home/nonroot/.rustup

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --no-modify-path --default-toolchain stable --profile minimal \
    && . /home/nonroot/.cargo/env \
    && rustup component add rustfmt clippy \
    && rustup toolchain install nightly-2026-08-03 --profile minimal \
         -c rustfmt -c rustc-dev -c llvm-tools \
    && cargo --version && rustc --version \
    && rm -rf /home/nonroot/.rustup/downloads

ENV PATH="/home/nonroot/.cargo/bin:${PATH}"

# Set workspace directory
WORKDIR /workspaces/cicd-squabbler

# Default shell
ENV SHELL=/bin/bash
